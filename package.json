{
  "name": "kona",
  "description": "Highlight text on web pages and in AI chats, keep it with your notes, and jump back to it.",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "build:web": "node -e \"require('fs').rmSync('.output/site',{recursive:true,force:true})\" && npm run build:site && npm run build:app && npm run build:team",
    "preview:web": "vite preview --config site/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "dev:team": "vite --config team/vite.config.ts",
    "build:team": "vite build --config team/vite.config.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketpandey05/kona.git"
  }
}
